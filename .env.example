# Sao chep file nay thanh ".env" roi chinh lai cho dung moi truong cua ban

# ==== Che do phan loai doi tuong uu tien ====
# PRIORITY_MODE=full (mac dinh, khong dat gi hoac dat sai gia tri cung roi ve full) - GIU NGUYEN
# 7 loai doi tuong uu tien CHI TIET nhu tu truoc den nay (Cấp cứu, ≥75 tuổi, Trẻ em dưới 6 tuổi,
# Phụ nữ có thai, Khuyết tật đặc biệt nặng, Khuyết tật nặng, Có công với cách mạng) + Đối tượng
# thường - xem day du trong src/config/priorityRules.js.
#
# PRIORITY_MODE=basic - GOP CA 7 loai tren THANH 1 MA DUY NHAT "Ưu tiên" - danh cho phong
# kham/don vi KHONG can phan loai chi tiet ly do uu tien, chi can 2 luong don gian: "Ưu tiên" /
# "Đối tượng thường". Ap dung DONG BO o TAT CA man hinh (kiosk boc so cho benh nhan /kiosk, kiosk
# cap so cho nhan vien /staff-kiosk, man hinh quay /counter, widget sieu nho tren may nhan vien,
# man hinh cho /waiting-screen, man hinh benh nhan /patient-screen) - KHONG can chinh gi them o
# widget/tung man hinh rieng le, tat ca tu dong "an theo" gia tri nay vi deu doc danh sach doi
# tuong uu tien qua API /api/priority-rules chung 1 nguon.
# Luu y: o Kiosk cong khai (/kiosk), benh nhan van duoc TU DONG xep vao "Ưu tiên" neu tuoi tren
# CCCD tu 75 tro len hoac duoi 6 tuoi (giu nguyen logic tu dong cu, chi gop nhan hien thi) - cac
# ly do "tu khai" khac (mang thai, khuyet tat, co cong, cap cuu) van CHI danh cho Nhan vien tu
# chon/xac dinh tai /staff-kiosk hoac widget nhu truoc, khong tu dong duoc o kiosk cong khai.
# Doi gia tri: sua dong duoi day roi KHOI DONG LAI server ("npm start") de ap dung.
PRIORITY_MODE=full

# ==== Thong tin hien thi (ten don vi, dong chan trang) ====
# Ten trung tam y te/phong kham - hien o dau man hinh Kiosk boc so (/kiosk). Doi gia tri: sua dong
# duoi day roi KHOI DONG LAI server de ap dung (khong can khoi dong lai trinh duyet, trang se tu
# lay gia tri moi khi tai lai).
CLINIC_NAME=Trung tâm Y tế

# Dong chu nho o CUOI man hinh Kiosk boc so (/kiosk) VA o CUOI phieu in so thu tu - vi du dia chi,
# hotline, gio lam viec. De trong neu khong can hien dong chan trang.
CLINIC_FOOTER_TEXT=Vui lòng giữ phiếu và theo dõi màn hình gọi số

# Dong chu nho THU 2 (tuy chon) - hien THEM 1 dong ngay duoi CLINIC_FOOTER_TEXT o tren, cung luc o
# CA man hinh Kiosk boc so (/kiosk) VA phieu in so thu tu - vi du dong con lai trong 2 dong dia
# chi/hotline, hoac 1 dong khuyen cao khac. De trong neu chi can 1 dong chan trang (dung
# CLINIC_FOOTER_TEXT o tren la du).
CLINIC_FOOTER_TEXT_2=

# Anh nen cho man hinh Kiosk boc so (/kiosk). Duong dan TINH TU thu muc public/ (bat dau bang "/").
# File anh THAT SU phai duoc dat trong thu muc public/ cua source code (vi du: cho file vao
# public/kiosk/assets/ten-file.jpg roi dat gia tri ben duoi la "/kiosk/assets/ten-file.jpg").
# Da co san 1 anh nen mac dinh (hoa tiet trang tri toi mau, khong co logo/thuong hieu rieng) tai
# public/kiosk/assets/background-default.svg - thay the file nay (giu nguyen ten, hoac doi duong
# dan ben duoi) bang anh cua don vi ban de dung logo/hinh anh rieng. De trong = dung nen mau toi
# mac dinh nhu cu (khong co anh).
KIOSK_BACKGROUND_IMAGE=/kiosk/assets/background-default.svg

# Anh LOGO cua don vi, hien o GOC TREN-TRAI man hinh Kiosk boc so (/kiosk), thay cho icon "chu
# thap y te" mac dinh dung chung. Duong dan TINH TU thu muc public/ (bat dau bang "/"), file anh
# THAT SU phai dat trong thu muc public/ (vi du: cho file vao public/kiosk/assets/logo.png roi dat
# gia tri ben duoi la "/kiosk/assets/logo.png"). Nen dung anh vuong/gan vuong, nen trong suot
# (PNG) de hien dep trong khung 40x40px. De trong = dung icon mac dinh nhu cu (khong co logo).
KIOSK_LOGO_IMAGE=

# Anh LOGO in tren ĐẦU PHIẾU (mẫu in số thứ tự), ngay phía trên tên đơn vị - GIỐNG HOẶC KHÁC anh
# logo o man hinh Kiosk phia tren cung duoc (vi du logo phieu in can trang/den-trang de hop voi may
# in nhiet, khac logo mau tren man hinh). Duong dan TINH TU thu muc public/ (bat dau bang "/"),
# file anh THAT SU phai dat trong thu muc public/. Máy in nhiệt thường chỉ in được đen trắng, nên
# ưu tiên ảnh logo dạng đường nét đơn giản, ít chi tiết/không có nền màu để khi in ra không bị
# đen kịt/mờ chữ. De trong = phieu in KHONG co logo (nhu cu).
PRINT_LOGO_IMAGE=

# Duong dan file du lieu SQLite (tu tao neu chua co, khong can cai dat database rieng)
SQLITE_FILE=./data/queue.db

# Cong chay server Node.js. Neu cong nay dang bi chuong trinh khac chiem dung luc
# khoi dong, server se TU DONG thu cac cong ke tiep (4001, 4002...) thay vi bao loi
# roi tat - xem canh bao in ra man hinh console de biet cong THAT SU dang chay la
# cong nao (va sua lai PORT= o day cho khop lau dai neu muon).
PORT=4000

# So ngay giu du lieu ve truoc khi tu dong xoa (chay don don dep dinh ky, xem src/services/cleanupService.js)
DATA_RETENTION_DAYS=3

# Mat khau de vao khu vuc nhan vien (man hinh /counter, /staff-kiosk). Doi mat khau: sua dong
# duoi day roi KHOI DONG LAI server ("npm start") de ap dung mat khau moi.
STAFF_PASSWORD=His4@123

# So phut "nghi" bat buoc giua 2 lan lay so cua CUNG 1 nguoi (doi chieu qua so CCCD/BHYT) tai
# KIOSK CONG KHAI (danh cho benh nhan) - chong lay so lien tuc/spam. KHONG ap dung cho kiosk
# nhan vien (/staff-kiosk), vi do la nhan vien chu dong cap so, khong phai benh nhan tu bam.
# Doi gia tri: sua dong duoi day roi KHOI DONG LAI server de ap dung.
KIOSK_COOLDOWN_MINUTES=5

# So giay TU DONG xac nhan tai KIOSK CONG KHAI (/kiosk). Nguyen tac: benh nhan tai kiosk cong khai
# KHONG duoc dung ban phim/chuot, chi duoc thao tac qua may quet QR - vi vay moi buoc "xac nhan"
# (chuyen sang buoc chon doi tuong uu tien, hoac chon "Khong thuoc dien uu tien" neu khong quet/chon
# gi them) se TU DONG dien ra sau so giay dem nguoc nay ke tu lan quet/thao tac gan nhat. Cac nut bam
# thu cong van con tren man hinh (du phong khi can), nhung khong bat buoc phai bam.
# Doi gia tri: sua dong duoi day roi KHOI DONG LAI server de ap dung.
KIOSK_AUTO_CONFIRM_SECONDS=5

# STAFF_KIOSK_SKIP_VERIFY=false (mac dinh) - o man hinh Kiosk cap so - Nhan vien (/staff-kiosk),
# sau khi nhan vien BAM CHON 1 doi tuong uu tien, he thong chuyen sang man hinh trung gian "Sẵn
# sàng quét" de nhan vien tu quyet dinh: quet CCCD/BHYT de XAC MINH, hoac bam nut "Cấp số ngay -
# bỏ qua xác minh" de cap so ngay khong can giay to.
#
# STAFF_KIOSK_SKIP_VERIFY=true - BO HAN man hinh trung gian do: bam chon 1 doi tuong la CAP SO
# NGAY LAP TUC (tuong duong nhu da bam san "Cấp số ngay"), KHONG con man hinh nao cho quet xac
# minh nua. Dung khi don vi KHONG can/khong muon buoc xac minh bang CCCD/BHYT o man hinh nay -
# TRANH DUNG mot van de thuc te da gap: trong luc man hinh "Sẵn sàng quét" con dang mo (cho nhan
# vien xac minh cho 1 benh nhan), neu dung luc do co 1 luot quet CUA BENH NHAN KHAC (khong lien
# quan) lot vao, he thong se HIEU NHAM do la luot quet xac minh cho doi tuong dang cho, gan nham
# thong tin benh nhan cho ve so. Bat che do nay loai bo han "cua so thoi gian" gay nham lan do,
# vi khong con buoc cho xac minh nao nua - moi luot quet sau khi bam chon xong deu tu dong duoc
# xu ly boi luong QUET DOC LAP rieng (xem README, muc "quét độc lập" - tu dong xac dinh doi tuong
# qua tuoi tren CCCD roi cap so cho DUNG nguoi vua quet, khong lien quan gi toi nut vua bam).
# Doi gia tri: sua dong duoi day roi KHOI DONG LAI server de ap dung.
STAFF_KIOSK_SKIP_VERIFY=false

# SEPARATE_PRIORITY_SEQUENCE=false (mac dinh) - TAT: chi co DUY NHAT 1 day so thu tu dung chung cho
# ca ve UU TIEN va ve THUONG trong ngay (giu nguyen hanh vi tu truoc den nay), vi du: 001, 002, 003...
# tang dan lien tuc bat ke ve do la uu tien hay thuong.
#
# SEPARATE_PRIORITY_SEQUENCE=true - BAT: tach thanh 2 DAY SO RIENG, moi day tu tang dan doc lap
# ngay tu 1 trong ngay, phan biet bang 1 CHU CAI TIEN TO ghep truoc so:
#   - Ve THUONG (khong thuoc dien uu tien nao)  -> tien to o NORMAL_SEQ_PREFIX ben duoi (vd: T001, T002...)
#   - Ve UU TIEN (bat ky loai nao trong so cac doi tuong uu tien dang bat - xem PRIORITY_MODE o tren)
#     -> tien to o PRIORITY_SEQ_PREFIX ben duoi (vd: U001, U002...). TAT CA cac loai uu tien (cap
#     cuu, nguoi gia, tre em... trong che do "full", hoac "Uu tien" gop chung trong che do "basic")
#     DUNG CHUNG 1 day U nay (khong tach rieng tung loai) - de so con giu dung thu tu cap phat thuc
#     te giua cac doi tuong uu tien voi nhau (dung lam tieu chi phu khi goi so cung 1 hang uu tien).
# Ap dung DONG BO o ca 3 noi cap so: Kiosk cong khai cho benh nhan tu bam (/kiosk), Kiosk cap so cho
# nhan vien (/staff-kiosk, ke ca widget Electron cap nhanh), va hien thi o man hinh Quay/Man hinh
# cho/Man hinh benh nhan khi goi so (phieu in, man hinh "vua cap", so dang goi, so bi bo qua...).
# LUU Y: am thanh phat tu dong o man hinh benh nhan (/patient-screen) hien CHI doc CHU SO (khong
# doc duoc chu cai tien to) o phan am thanh ghi am san (file mp3) - phan doc du phong bang giong
# may (khi thieu file am thanh) co doc them tien to. Ve da cap TRUOC KHI bat/tat tinh nang nay se
# giu nguyen tien to (hoac khong co tien to) nhu luc no duoc cap, khong bi doi lai theo cau hinh moi.
# Doi gia tri: sua dong duoi day roi KHOI DONG LAI server de ap dung.
SEPARATE_PRIORITY_SEQUENCE=false
# Chu cai tien to cho ve UU TIEN khi SEPARATE_PRIORITY_SEQUENCE=true (mac dinh U - "Uu tien").
PRIORITY_SEQ_PREFIX=U
# Chu cai tien to cho ve THUONG khi SEPARATE_PRIORITY_SEQUENCE=true (mac dinh T - "Thuong").
NORMAL_SEQ_PREFIX=T

# MUC 100/101/102 - Rang buoc CAP (khong phai GOI) ve UU TIEN (ap dung DONG BO o ca /kiosk - quet QR
# - lan /staff-kiosk - nut bam/QR cap nhanh, ke ca ma "Cấp cứu", KHONG mien tru ma nao): CHI cho phep
# cap ve uu tien khi STT THUONG da duoc GOI/BO QUA tai quay dat toi thieu gia tri duoi day (vd: mac
# dinh 16 - khong ve uu tien nao, ke ca ve uu tien dau tien, duoc cap cho toi khi STT thuong da goi/
# bo qua dat >=16), VA STT uu tien SAP cap PHAI NHO HON STT thuong da xu ly (MUC 102: quay lai dung
# "nho hon" - CHAN CA KHI BANG NHAU - theo yeu cau moi nhat; vi du threshold=16: STT thuong da xu ly
# dat 16 thi CHUA duoc cap U016 (16 khong nho hon 16), phai doi STT thuong len 17 moi cap duoc U016;
# rang buoc nay tu "that chat dan" khi cang cap nhieu ve uu tien, vi STT uu tien tiep theo cang luc
# cang lon).
# CHI CO HIEU LUC khi SEPARATE_PRIORITY_SEQUENCE=true o tren (can 2 day so doc lap moi so sanh duoc
# - neu dung chung 1 day so, bat rang buoc nay se CHAN VINH VIEN moi ve uu tien, nen tu dong bo qua
# neu SEPARATE_PRIORITY_SEQUENCE=false).
# Doi gia tri: sua dong duoi day roi KHOI DONG LAI server de ap dung.
PRIORITY_ISSUE_GATE_THRESHOLD=16

# ==== Ma QR "cap nhanh" o man hinh /staff-kiosk (Kiosk cap so - Nhan vien) ====
# Xem giai thich chi tiet trong file .env - tom tat: moi doi tuong co 1 ma bi mat rieng, dung de
# tao/xac thuc QR "cap nhanh" tren man hinh /staff-kiosk. De TRONG = tat tinh nang cap nhanh cho
# doi tuong do.
# - Neu PRIORITY_MODE=full (mac dinh) o tren: dung 7 dong QUICK_QR_CODE_<ma> ben duoi (7 muc uu
#   tien + "Đối tượng thường").
# - Neu PRIORITY_MODE=basic: he thong CHI con 2 doi tuong "PRIORITY" ("Ưu tiên") va "NORMAL" (
#   "Đối tượng thường") - CHI 2 bien QUICK_QR_CODE_PRIORITY / QUICK_QR_CODE_NORMAL la co tac dung,
#   5 dong con lai (AGE75, CHILD6, PREGNANT, DISAB_EXTREME, DISAB_SEVERE, MERIT_BHYT, EMERGENCY)
#   se KHONG duoc dung toi (khong can xoa, chi khong co hieu luc).
QUICK_QR_CODE_PRIORITY=
QUICK_QR_CODE_EMERGENCY=
QUICK_QR_CODE_AGE75=
QUICK_QR_CODE_CHILD6=
QUICK_QR_CODE_PREGNANT=
QUICK_QR_CODE_DISAB_EXTREME=
QUICK_QR_CODE_DISAB_SEVERE=
QUICK_QR_CODE_MERIT_BHYT=
QUICK_QR_CODE_NORMAL=

# STAFF_BATCH_MAX_QUANTITY=50 (mac dinh) - GIOI HAN so luong toi da cho vong lap "cấp nhiều số TỰ
# ĐỘNG" o man hinh /staff-kiosk (chon 1 doi tuong uu tien + nhap so luong can cap, bam la HE THONG
# TU DONG lap lai dung luong cap+in 1 so binh thuong nhieu lan lien tiep, nhan vien co the bam
# "Dừng" bat ky luc nao - xem autoIssueLoop() trong public/staff-kiosk/staff-kiosk.js). Gia tri nay
# chi de CHAN nhan vien lo tay nhap nham 1 con so qua lon (vi du go nham "1000" thay vi "10") khien
# tu dong cap+in hang tram phieu lien tuc gay lang phi giay/qua tai may in - KHONG can doi neu don
# vi dung binh thuong (moi lan chi vai chuc so). LUU Y: gia tri nay CHI duoc CLIENT tu ap dung
# (khong con route server rieng nao kiem tra lai, vi khong con "1 lo" o tang server nua - moi lan
# tu dong lap chi la 1 request binh thuong toi POST /api/tickets/staff, giong het nhu nhan vien tu
# tay bam nut nhieu lan). Doi gia tri: sua dong duoi day roi KHOI DONG LAI server de ap dung.
STAFF_BATCH_MAX_QUANTITY=50

# ==== Cau hinh may in phieu ====
# MAC DINH he thong in phieu NGAY TREN TRINH DUYET cua tung may kiosk/quay tiep nhan (hop thoai in
# chuan cua trinh duyet - xem public/print-receipt.js) - hop thoai nay TU NHAN dien:
#  - May in nhiet (vi du Epson) noi qua CONG USB, da cai driver, tren may tinh/laptop.
#  - May in nhiet noi qua BLUETOOTH, da ghep doi + cai dich vu in, tren dien thoai/may tinh bang.
# Cach nay hoat dong dung cho MOI may trong he thong (kiosk, quay tiep nhan...) du may in duoc gan
# vao may nao, KHONG can cau hinh gi them o day - phan duoi day CHI danh cho truong hop nang cao
# can them: in TRUC TIEP tu server (vi du server co may in ESC/POS gan truc tiep vao no).
#
# PRINTER_ENABLED=false (mac dinh) => KHONG in them o phia server, chi dung cach in tren trinh
# duyet o tren la du.
PRINTER_ENABLED=false

# Loai driver may in phia server (chi dung khi PRINTER_ENABLED=true): epson | star
PRINTER_TYPE=epson

# Cach ket noi may in phia server, chon 1 trong 3 kieu duoi day roi bo comment dong tuong ung:
# - May in USB nhan la may in mac dinh cua he dieu hanh:
# PRINTER_INTERFACE=printer:auto
# - May in mang LAN (thay bang IP that cua may in):
# PRINTER_INTERFACE=tcp://192.168.1.100:9100
# - May in qua cong serial/USB tren Linux:
# PRINTER_INTERFACE=/dev/usb/lp0
PRINTER_INTERFACE=printer:auto

# ==== Man hinh Man hinh benh nhan (/patient-screen) ====
# % phong to chu SO THU TU tren man hinh /patient-screen so voi mac dinh (100 = giu nguyen kich
# thuoc cu, 130 = to hon 30%, 80 = nho hon 20%...). Chi nhan gia tri tu 50 den 300 - gia tri ngoai
# khoang hoac khong phai so se BI BO QUA (dung lai 100%) kem canh bao trong log cua server, tranh 1
# gia tri sai lam vo giao dien (chu qua to tran man hinh, hoac qua nho khong doc duoc).
# Doi gia tri: sua dong duoi day roi KHOI DONG LAI server de ap dung.
PATIENT_SCREEN_NUMBER_FONT_SCALE=100

# Mau trang tri o 2 khoang trong (sidebar) ben trai/phai man hinh /patient-screen - man hinh nay
# von co 2 khoang trong 2 ben khi khong trang tri gi (chi co so thu tu o giua), co the chon 1 trong
# cac mau co san duoi day de trang tri theo dip le/su kien, hoac de "default" (hoac de trong) neu
# khong can trang tri gi (an 2 sidebar, giao dien gon nhu cu). Cac gia tri hop le:
#   default      = khong trang tri (mac dinh, an 2 sidebar)
#   tet          = mau Chuc mung nam moi (Tet Nguyen Dan)
#   doctors_day  = mau Ngay Thay thuoc Viet Nam (27/2)
#   national_day = mau Quoc khanh Viet Nam (2/9)
#   apr30_may1   = mau 30/4 - 1/5 (Ngay Giai phong mien Nam - Quoc te Lao dong)
#   hung_king    = mau Gio To Hung Vuong (mung 10/3 am lich)
# Gia tri khong nam trong danh sach tren se BI BO QUA (dung lai "default") kem canh bao trong log
# cua server. Doi gia tri: sua dong duoi day roi KHOI DONG LAI server de ap dung.
PATIENT_SCREEN_THEME=default

# ==== "Chia khoa" cho widget vao thang man hinh /kiosk (boc so cho benh nhan) ====
# Man hinh /kiosk (boc so cho benh nhan) BINH THUONG cung yeu cau dang nhap nhan vien nhu cac man
# hinh khac (/counter, /staff-kiosk...) - nhung ung dung widget Electron (electron-widget/) LUON TU
# GUI KEM 1 "chia khoa" rieng (qua header HTTP, khong phai mat khau/cookie) tren MOI request toi
# /kiosk de vao thang man hinh nay MA KHONG CAN dang nhap, DU server vua khoi dong lai (session
# dang nhap luu trong bo nho RAM se mat het khi restart) hay widget vua tat/mo lai. Bypass nay CHI
# ap dung cho DUY NHAT "/kiosk" - /staff-kiosk, /counter, /counter-admin van bat buoc dang nhap
# nhu cu.
# Neu KHONG dat bien nay, server dung 1 gia tri MAC DINH san co (va widget cung tu dung dung gia
# tri mac dinh do) - moi thu "chay duoc ngay" khong can cau hinh gi them. CHI can doi (dat gia tri
# rieng duoi day) neu server dat o noi co the bi truy cap tu ben ngoai mang noi bo va muon "chia
# khoa" nay kho doan hon gia tri mac dinh - luu y: khi da doi, PHAI mo widget (bieu tuong tren khay
# he thong) > "Đổi địa chỉ máy chủ" hoac file cau hinh cua widget de dat CUNG 1 gia tri nay, neu
# khong widget se khong vao duoc /kiosk nua (phai dang nhap thu cong nhu truoc).
# KIOSK_WIDGET_SECRET=doi-thanh-1-chuoi-rieng-cua-ban

# ==== Cap nhat phan mem server (MUC 117) ====
# Server tu kiem tra phien ban moi tren GitHub Release (30 giay sau khi khoi dong, roi moi 6 gio) -
# nhan vien xem/cap nhat o Trang chu > "Cập nhật phần mềm". Repo lay tu package.json (build.publish).
# UPDATE_CHECK_ENABLED=false de tat hoan toan (vd may chu khong co Internet).
UPDATE_CHECK_ENABLED=true
# UPDATE_CHECK_INTERVAL_HOURS=6
# Doi repo (dang owner/ten-repo) neu khac package.json:
# UPDATE_GITHUB_REPO=
# Repo PRIVATE: token GitHub chi can quyen doc (Contents: Read-only):
# UPDATE_GITHUB_TOKEN=
